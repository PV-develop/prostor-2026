---
/**
 * Карточка члена команды: фото 3/4, номер, имя, роль, год.
 */
interface Props {
  photo: string;
  name: string;
  role: string;
  since?: string;
  number: string;
  index?: number;
}
const { photo, name, role, since, number, index = 0 } = Astro.props;
---
<div class="team-card" data-reveal data-team-card style={`transition-delay:${index * 90}ms`}>
  <div class="team-card__photo">
    <img src={photo} alt={name} loading="lazy" />
    <span class="team-card__number" data-team-number>{number}</span>
  </div>
  <div class="team-card__caption">
    <div class="team-card__name h-display" data-team-name>{name}</div>
    <div class="team-card__role" data-team-role>{role}</div>
    {since && <div class="team-card__since" data-team-year>{since}</div>}
  </div>
</div>

<style>
  .team-card {
    position: relative;
    background: var(--color-paper);
    color: var(--color-ink);
    padding: 20px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  .team-card__photo {
    position: relative;
    aspect-ratio: 3/4;
    overflow: hidden;
    background: var(--color-photo-bg);
    flex: none;
  }
  .team-card__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }
  .team-card__number {
    position: absolute;
    left: 20px;
    bottom: 20px;
    min-width: 44px;
    box-sizing: border-box;
    padding: 10px 12px;
    background: var(--color-red);
    color: var(--color-paper);
    font: 500 13px/1 var(--font-mono);
    text-align: center;
  }
  .team-card__caption { padding: 24px 0 4px; }
  .team-card__name { font-size: var(--fs-team-name); line-height: var(--fs-team-name-lh); }
  .team-card__role { font: 400 13px/1.35 var(--font-mono); margin-top: 12px; }
  .team-card__since { font: 400 13px/1.35 var(--font-mono); margin-top: 20px; }
  @media (max-width: 768px) {
    .team-card { padding: 12px; }
    .team-card__caption { padding: 16px 0 2px; }
    .team-card__name { font-size: 22px; }
    .team-card__role, .team-card__since { font-size: 11px; margin-top: 10px; }
    .team-card__since { margin-top: 12px; }
    .team-card__number {
      left: 10px;
      bottom: 10px;
      min-width: 32px;
      padding: 8px;
      font-size: 10px;
    }
  }
</style>
