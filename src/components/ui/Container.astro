---
/**
 * Контейнер контента: боковые поля страницы.
 * На мобильном поле сужаются до --pad-page-mobile.
 */
interface Props {
  as?: 'div' | 'section' | 'header' | 'footer' | 'nav';
  class?: string;
}
const { as: Tag = 'div', class: cls } = Astro.props;
---
<Tag class:list={['container', cls]}><slot /></Tag>

<style>
  @media (max-width: 768px) {
    .container { padding-inline: var(--pad-page-mobile); }
  }
</style>
