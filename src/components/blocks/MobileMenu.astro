---
/**
 * Разворачивающееся меню (открытие кнопкой шапки).
 * Показ/скрытие — атрибут data-open, ставит main.ts.
 */
import type { NavLink, ServiceGroup, SocialLink } from '../../content/home';

interface Props {
  sections: NavLink[];
  hiddenSections: NavLink[];
  services: ServiceGroup[];
  pricesTitle: string;
  prices: string[];
  bigLinks: NavLink[];
  socials: SocialLink[];
  phone: string;
  email: string;
  cta: string;
  /** Куда ведёт CTA меню; на внутренних страницах — якорь их формы */
  ctaHref?: string;
  /** Префикс ссылок пунктов услуг ('/' на внутренних страницах → /#directions) */
  serviceLinkBase?: string;
  /** Заголовок группы услуг текущей страницы — получает активное состояние */
  activeService?: string;
}
const {
  sections, hiddenSections, services, pricesTitle, prices, bigLinks, socials, phone, email, cta,
  ctaHref = '#contacts', serviceLinkBase = '', activeService,
} = Astro.props;

const socialIcons: Record<string, string> = {
  telegram: "M3 10.5 20 4l-3.5 16-5-5-3 3 .5-6 8-5-10 4.5Z",
  whatsapp: "M5 18 3 21l4-1a9 9 0 1 0-2-2Z m3-11 2 3-1 1c1 2 2 3 4 3l1-1 3 1c-1 4-6 3-9 0S5 8 8 7Z",
  vk: "M3 7h3c0 4 2 6 3 7V7h3v4c2-1 3-3 4-4h4l-4 6c3 2 4 4 4 4h-4l-4-4v4H9C5 16 3 12 3 7Z",
  youtube: "",
  dzen: "M12 2c0 8 2 10 10 10-8 0-10 2-10 10 0-8-2-10-10-10C10 12 12 10 12 2Z",
};
---
<div class="mobile-menu" data-menu data-open="false">
  <div class="mobile-menu__head" data-mh>
    <a href="#top" aria-label="Простор" class="mobile-menu__logo">
      <img src="/images/logo/logo-black.svg" alt="" />
    </a>
    <a href="tel:88005555070" class="mobile-menu__phone">{phone}</a>
    <button class="mobile-menu__close" data-mclose aria-label="Закрыть меню">
      <span data-mhlabel>Закрыть</span>
      <span class="mobile-menu__x" aria-hidden="true">×</span>
    </button>
  </div>

  <div class="mobile-menu__grid" data-mg>
    <nav class="mobile-menu__nav" data-mmain aria-label="Разделы сайта">
      {sections.map((s) => (
        <a href={s.href}>
          {s.num && <span class="mobile-menu__num">{s.num}</span>}{s.label}
        </a>
      ))}
      {/* На десктопе скрыты CSS-ом, на мобильном видны (как в оригинале) */}
      {hiddenSections.map((s) => (
        <a href={s.href} data-mextra>{s.label}</a>
      ))}
    </nav>

    <div class="mobile-menu__services" data-mservices>
      <div class="mobile-menu__services-label">Услуги</div>
      <div class="mobile-menu__groups" data-msnav>
        {services.map((g) => (
          <details class:list={['mobile-menu__group', { 'mobile-menu__group--active': activeService === g.title }]} data-mgrp data-active={activeService === g.title ? '' : undefined} open>
            <summary>{g.title}<span data-mplus>+</span></summary>
            <div class="mobile-menu__group-links">
              {g.items.map((i) => <a href={`${serviceLinkBase}#directions`}>{i}</a>)}
            </div>
          </details>
        ))}
      </div>
    </div>

    <div class="mobile-menu__aside" data-mc>
      {/* Разворачивающийся список цен (десктоп; на мобильном скрыт) */}
      <details>
        <summary>{pricesTitle}<span aria-hidden="true">+</span></summary>
        <div class="mobile-menu__prices">
          {prices.map((p) => <a href="#">{p}</a>)}
        </div>
      </details>
      {bigLinks.map((l) => (
        <a href={l.href} class="mobile-menu__big-link">{l.label} <span aria-hidden="true">↗</span></a>
      ))}
      <div data-mcontacts class="mobile-menu__contacts">
        <a href={`mailto:${email}`} class="mobile-menu__email">{email} <span data-marrow aria-hidden="true">↗</span></a>
        <a data-mphone href="tel:88005555070" class="mobile-menu__phone-mini">{phone}</a>
      </div>
      <div data-msoc class="mobile-menu__socials">
        {socials.map((s) => (
          <a href={s.href} target="_blank" rel="noopener noreferrer">
            {s.icon === 'youtube' ? (
              <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="5" width="20" height="14" rx="4" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="m10 9 6 3-6 3Z" fill="currentColor"/></svg>
            ) : (
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={socialIcons[s.icon]} /></svg>
            )}
            {s.label}
          </a>
        ))}
      </div>
      <a href={ctaHref} data-mcta class="mobile-menu__cta">{cta} <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</div>

<style>
  .mobile-menu {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: var(--z-menu);
    box-sizing: border-box;
    background: var(--color-paper);
    color: var(--color-ink);
    border-bottom: 1px solid var(--line-ink-22);
    max-height: 92svh;
    overflow: auto;
    padding: 20px var(--pad-page) 68px;

    opacity: 0;
    visibility: hidden;
    transform: translateY(-14px);
    pointer-events: none;
    transition: opacity .3s ease, transform .45s var(--ease-smooth), visibility 0s linear .45s;
  }
  .mobile-menu[data-open="true"] {
    opacity: 1;
    visibility: visible;
    transform: none;
    pointer-events: auto;
    transition: opacity .35s ease .05s, transform .55s var(--ease-smooth) .05s;
  }

  .mobile-menu__head {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 28px;
    align-items: center;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--line-ink-14);
  }
  .mobile-menu__logo { display: flex; height: 31px; align-items: center; }
  .mobile-menu__logo img { display: block; height: 31px; width: auto; }
  .mobile-menu__phone {
    justify-self: start;
    font: 700 clamp(28px, 3vw, 44px)/1 var(--font-display);
    font-stretch: 25%;
    letter-spacing: var(--ls-menu-phone);
    color: var(--color-ink);
    white-space: nowrap;
  }
  .mobile-menu__close {
    all: unset;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    min-width: 124px;
    padding: 13px 20px;
    border: 1px solid var(--color-ink);
    color: var(--color-ink);
    font: 600 12px/1 var(--font-mono);
    letter-spacing: .1em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background .3s, color .3s;
  }
  .mobile-menu__close:hover { background: var(--color-ink); color: var(--color-paper); }
  .mobile-menu__x { font: 400 18px/1 var(--font-sans); }

  .mobile-menu__grid {
    display: grid;
    grid-template-columns: 3fr 6fr 2.4fr;
    gap: 40px;
    padding-top: 26px;
  }

  .mobile-menu__nav {
    display: flex;
    flex-direction: column;
    gap: 16px;
    align-items: flex-start;
    border-right: 1px solid var(--line-ink-12);
    padding-right: 36px;
  }
  .mobile-menu__nav a {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    font: 700 var(--fs-menu-main)/var(--fs-menu-main-lh) var(--font-display);
    font-stretch: 25%;
    text-transform: uppercase;
    color: var(--color-ink);
    transition: color var(--dur-color-fast);
  }
  .mobile-menu__nav a:hover { color: var(--color-red); }
  /* Дополнительные разделы (Цены и т.п.): скрыты на десктопе, видны на мобильном */
  .mobile-menu__nav [data-mextra] { display: none; }
  .mobile-menu__num {
    margin-top: 7px;
    font: 500 10px/1 var(--font-mono);
    letter-spacing: var(--ls-label);
    color: var(--color-red);
  }

  .mobile-menu__services-label {
    margin-bottom: 22px;
    font: 500 13px/1.35 var(--font-sans);
    color: var(--color-red);
    display: flex;
    gap: 12px;
    align-items: center;
  }
  .mobile-menu__services-label::before {
    content: '';
    width: 8px;
    height: 8px;
    background: var(--color-red);
    display: inline-block;
  }
  .mobile-menu__groups {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 30px 36px;
  }
  .mobile-menu__groups details { margin: 0; }
  .mobile-menu__groups summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 15px;
    font: 700 var(--fs-menu-group)/1 var(--font-display);
    font-stretch: 25%;
    text-transform: uppercase;
    cursor: pointer;
  }
  /* На десктопе группы услуг всегда раскрыты: заголовок не кликается и не подсвечивается */
  @media (min-width: 769px) {
    .mobile-menu__groups summary { pointer-events: none; cursor: default; }
  }
  .mobile-menu__groups details[open] > summary > span:last-child { transform: rotate(45deg); }
  /* Активная группа услуг (текущая страница): красный маркер перед заголовком */
  .mobile-menu__groups details[data-active] > summary { color: var(--color-red); }
  .mobile-menu__groups details[data-active] > summary::before {
    content: '';
    width: 8px;
    height: 8px;
    background: var(--color-red);
    flex: none;
  }
  .mobile-menu__groups [data-mplus] {
    display: none;
    font: 400 22px/1 var(--font-sans);
    transition: transform .3s;
  }
  .mobile-menu__group-links {
    display: flex;
    flex-direction: column;
    gap: 9px;
  }
  .mobile-menu__group-links a {
    font: 400 14px/var(--lh-menu-item) var(--font-sans);
    color: var(--ink-62);
    transition: color .2s;
  }
  .mobile-menu__group-links a:hover { color: var(--color-red); }

  .mobile-menu__aside {
    display: flex;
    flex-direction: column;
    gap: 16px;
    align-items: flex-start;
  }
  .mobile-menu__big-link {
    display: flex;
    align-items: center;
    gap: 8px;
    font: 700 var(--fs-menu-main)/var(--fs-menu-main-lh) var(--font-display);
    font-stretch: 25%;
    text-transform: uppercase;
    color: var(--color-ink);
    transition: color var(--dur-color-fast);
  }
  .mobile-menu__big-link:hover { color: var(--color-red); }
  /* Стрелка у крупных ссылок — мелкая, как в экспорте (20px Onest) */
  .mobile-menu__big-link > span:last-child {
    font: 400 20px/1 var(--font-sans);
  }
  /* Разворачивающийся список цен в правой колонке (десктоп) */
  .mobile-menu__aside > details { width: 100%; }
  .mobile-menu__aside > details summary {
    display: flex;
    align-items: center;
    gap: 10px;
    cursor: pointer;
    font: 700 var(--fs-menu-main)/var(--fs-menu-main-lh) var(--font-display);
    font-stretch: 25%;
    text-transform: uppercase;
    color: var(--color-ink);
    transition: color var(--dur-color-fast);
  }
  .mobile-menu__aside > details summary:hover { color: var(--color-red); }
  .mobile-menu__aside > details summary > span {
    font: 400 22px/1 var(--font-sans);
    transition: transform .3s;
  }
  .mobile-menu__aside > details[open] summary > span { transform: rotate(45deg); }
  .mobile-menu__prices {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 14px 0 2px;
  }
  .mobile-menu__prices a {
    font: 400 14px/1.4 var(--font-sans);
    color: var(--ink-62);
    transition: color .2s;
  }
  .mobile-menu__prices a:hover { color: var(--color-red); }
  .mobile-menu__email {
    margin-top: 10px;
    display: flex;
    align-items: center;
    gap: 6px;
    font: 500 14px/1.4 var(--font-sans);
    color: var(--color-ink);
    transition: color .2s;
  }
  .mobile-menu__email:hover { color: var(--color-red); }
  .mobile-menu__phone-mini {
    display: none;
    font: 500 14px/1.4 var(--font-sans);
    color: var(--color-ink);
  }
  .mobile-menu__socials {
    display: flex;
    flex-direction: column;
    gap: 11px;
    margin-top: 12px;
  }
  .mobile-menu__socials a {
    display: flex;
    align-items: center;
    gap: 10px;
    font: 500 13px/1.4 var(--font-sans);
    color: var(--ink-75);
    transition: color .2s;
  }
  .mobile-menu__socials a:hover { color: var(--color-red); }
  .mobile-menu__socials svg { width: 15px; height: 15px; flex: none; }
  .mobile-menu__cta {
    display: none;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    background: var(--color-red);
    color: var(--color-paper);
    padding: 20px 24px;
    font: 600 12px/1 var(--font-mono);
    letter-spacing: var(--ls-mono-label);
    text-transform: uppercase;
  }

  @media (max-width: 1100px) {
    .mobile-menu__grid { grid-template-columns: 1.3fr 1.6fr !important; }
    .mobile-menu__aside {
      grid-column: 1 / -1;
      flex-direction: row !important;
      flex-wrap: wrap;
      align-items: center;
      gap: 14px 30px;
    }
  }
  @media (max-width: 768px) {
    .mobile-menu { padding: 14px var(--pad-page-mobile) 44px; max-height: 100svh; }
    .mobile-menu__head {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 12px;
      padding-bottom: 14px;
    }
    .mobile-menu__head > a[href^="tel"] { display: none; }
    .mobile-menu__close {
      order: 2;
      margin-left: auto;
      min-width: 0;
      border: 0;
      background: transparent;
      padding: 2px;
      color: var(--color-ink) !important;
    }
    .mobile-menu__head [data-mhlabel] { display: none; }
    .mobile-menu__head > button > span:last-child { font-size: 28px; }
    .mobile-menu__grid { grid-template-columns: 1fr !important; gap: 24px !important; padding-top: 18px; }
    .mobile-menu__nav {
      display: grid !important;
      grid-template-columns: 1fr 1fr;
      gap: 20px 24px;
      border-right: 0;
      padding-right: 0;
      border-bottom: 1px solid var(--line-ink-12);
      padding-bottom: 22px;
    }
    .mobile-menu__nav > a { font-size: 26px; }
    .mobile-menu__nav > a > span { display: none; }
    .mobile-menu__nav [data-mextra] { display: block !important; }
    .mobile-menu__services { border-bottom: 1px solid var(--line-ink-12); padding-bottom: 22px; }
    .mobile-menu__groups { gap: 22px 20px !important; }
    .mobile-menu__groups [data-mplus] { display: inline; }
    .mobile-menu__groups summary { font-size: 20px !important; margin-bottom: 15px !important; }
    .mobile-menu__groups summary:hover { color: var(--color-red); }
    .mobile-menu__groups details[open] summary { margin-bottom: 15px !important; }
    .mobile-menu__aside {
      flex-direction: column !important;
      gap: 18px !important;
      align-items: stretch !important;
    }
    .mobile-menu__aside > details { display: none; }
    .mobile-menu__aside > a:not([data-mcta]) { display: none !important; }
    .mobile-menu__contacts {
      display: flex !important;
      flex-direction: row;
      justify-content: space-between;
      align-items: baseline;
      gap: 16px;
      margin-top: 6px;
    }
    .mobile-menu__contacts > a { margin-top: 0 !important; }
    .mobile-menu__socials {
      display: grid !important;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 16px 12px;
      margin-top: 6px;
    }
    .mobile-menu__cta { display: flex !important; margin-top: 12px; }
  }
</style>
