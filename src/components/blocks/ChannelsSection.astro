---
import Container from '../ui/Container.astro';
import SectionLabel from '../ui/SectionLabel.astro';
import SectionHeading from '../ui/SectionHeading.astro';

interface Props {
  id?: string;
  label?: string;
  heading: string;
  items: Array<{ title: string; description: string }>;
  footnote?: string;
}
const { id, label, heading, items, footnote } = Astro.props;
---

<section class="channels" id={id} aria-label={heading.replace(/<[^>]+>/g, '')}>
  <Container>
    <div class="channels__head" data-reveal>
      {label && <SectionLabel text={label} variant="h" tone="light" />}
      <SectionHeading html={heading} size="md" class="channels__heading" />
    </div>
    <ul class="channels__list">
      {
        items.map((item, i) => (
          <li class="channels__row" data-reveal style={`transition-delay:${i * 50}ms`}>
            <span class="channels__num">{String(i + 1).padStart(2, '0')}</span>
            {/* TODO: названия направлений могут стать ссылками на страницы услуг — разметка сохранена */}
            <span class="channels__title">{item.title}</span>
            <span class="channels__desc">{item.description}</span>
          </li>
        ))
      }
    </ul>
    {footnote && <p class="channels__footnote" data-reveal>{footnote}</p>}
  </Container>
</section>

<style>
  .channels {
    padding: var(--space-section-page-y) 0;
    background: var(--color-bg-card-light);
  }
  .channels__head {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }
  .section-heading :global(.stroke) {
    -webkit-text-stroke: 2px var(--color-text-primary);
    color: transparent;
  }
  .channels__list {
    list-style: none;
    margin: var(--space-3xl) 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--color-line-dark);
    border-bottom: 1px solid var(--color-line-dark);
  }
  .channels__row {
    display: grid;
    grid-template-columns: var(--page-index-col) minmax(0, 5fr) minmax(0, 7fr);
    column-gap: var(--space-col-gap);
    align-items: baseline;
    padding: var(--space-lg) 0;
  }
  .channels__row + .channels__row {
    border-top: 1px solid var(--color-line-dark-soft);
  }
  .channels__num {
    font: 500 var(--fs-label) / var(--lh-label) var(--font-mono);
    letter-spacing: var(--ls-mono);
    color: var(--color-text-accent-dark);
  }
  .channels__title {
    font: 700 var(--fs-h4) / var(--lh-tight) var(--font-display);
    font-stretch: 25%;
    text-transform: uppercase;
    text-wrap: balance;
  }
  .channels__desc {
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--color-text-on-light-74);
    text-wrap: pretty;
  }
  .channels__footnote {
    margin: var(--space-lg) 0 0;
    font-size: var(--fs-body-sm);
    line-height: var(--lh-body);
    color: var(--color-text-on-light-74);
    max-width: var(--desc-max);
  }
  @media (max-width: 768px) {
    .channels {
      padding: var(--space-section-page-y-mobile) 0;
    }
    .channels__list {
      margin-top: var(--space-xl);
    }
    .channels__row {
      grid-template-columns: var(--page-index-col-mobile) minmax(0, 1fr);
      gap: var(--space-xs) var(--space-sm);
      padding: var(--space-lg) 0;
    }
    .channels__num {
      grid-row: 1 / 3;
    }
    .channels__title,
    .channels__desc {
      grid-column: 2;
    }
    .channels__desc {
      font-size: var(--fs-body-sm);
    }
  }
</style>
