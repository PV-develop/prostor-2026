---
/**
 * Секция команды: сетка карточек TeamCard (auto-fit).
 */
import type { TeamMember } from '../../content/home';
import SectionLabel from '../ui/SectionLabel.astro';
import Button from '../ui/Button.astro';
import TeamCard from '../ui/TeamCard.astro';

interface Props {
  label: string;
  title: string[];
  allLink: { label: string; href: string };
  members: TeamMember[];
}
const { label, title, allLink, members } = Astro.props;
---
<div class="team on-dark" id="team-head">
  <SectionLabel variant="h" text={label} class="team__label" />
  <div class="team__head" data-reveal data-m="sechead">
    <h2 class="team__title h-display h-display--section">
      <span class="team__nowrap">{title[0]}</span><br />
      <span class="team__nowrap team__indent">{title[1]}</span>
    </h2>
    {/* Ссылка-заглушка до появления страницы команды (как в оригинале) */}
    <Button variant="paper-o" href={allLink.href} class="team__all" arrow="→">{allLink.label}</Button>
  </div>
  <div class="team__grid" data-m="team">
    {members.map((m, i) => <TeamCard {...m} index={i} />)}
  </div>
</div>

<style>
  .team { background: var(--color-ink); color: var(--color-paper); }
  .team :global(.team__label) { margin: 0 var(--pad-page) 40px; }
  .team__head {
    padding: 0 var(--pad-page);
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: var(--pad-page);
  }
  .team__title { flex: 1; min-width: 0; }
  .team__nowrap { white-space: nowrap; }
  .team__indent { padding-left: .6em; }
  .team :global(.team__all) { margin-bottom: 12px; white-space: nowrap; padding: 24px 28px; }
  .team__grid {
    margin-top: var(--section-gap);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 32px;
    padding: 0 var(--pad-page);
    align-items: stretch;
  }

  @media (max-width: 768px) {
    .team :global(.team__label) { margin: 0 var(--pad-page-mobile) 40px; }
    .team__head {
      flex-direction: column;
      align-items: flex-start;
      gap: 28px;
      padding: 0 var(--pad-page-mobile);
    }
    .team__head > :global(a) { margin-bottom: 0; }
    .team__grid {
      margin-top: 48px;
      padding: 0 var(--pad-page-mobile);
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
    }
  }
</style>
