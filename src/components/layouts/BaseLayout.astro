---
/**
 * Базовый шаблон: локальные шрифты с preload, SEO-мета, корневая разметка.
 */
import '../../styles/design-tokens.css';
import '../../styles/global.css';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  /** Класс для <html> (страничные модификаторы, например плавные якоря) */
  htmlClass?: string;
}
const { title, description, ogImage = '/images/logo/logo-white.svg', htmlClass } = Astro.props;
const pageTitle = `${title}`;
---
<!DOCTYPE html>
<html lang="ru" class={htmlClass}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  <link rel="icon" href="/images/logo/logo-white.svg" type="image/svg+xml" />

  <!-- Open Graph / Twitter Card (production-домен неизвестен — canonical не подставляем) -->
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="ru_RU" />
  <meta property="og:site_name" content="Простор" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <!-- Preload критических шрифтов -->
  <link rel="preload" href="/fonts/Steelfish-Bold.ttf" as="font" type="font/ttf" crossorigin />
  <link rel="preload" href="/fonts/Steelfish-ExtraBold.ttf" as="font" type="font/ttf" crossorigin />
  <link rel="preload" href="/fonts/onest-400.ttf" as="font" type="font/ttf" crossorigin />
  <link rel="preload" href="/fonts/onest-500.ttf" as="font" type="font/ttf" crossorigin />
</head>
<body>
  <slot />
  <script>import '../../scripts/main';</script>
</body>
</html>
